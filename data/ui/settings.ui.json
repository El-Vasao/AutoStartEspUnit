{
  "settings": {
    "wifi": {
      "title": "Wi‑Fi",
      "fields": [
        {
          "key": "ssid",
          "path": "wifi.ssid",
          "type": "text",
          "label": "Имя сети",
          "placeholder": "",
          "helpTitle": "Имя сети",
          "help": "Имя сети Wi‑Fi устройства."
        },
        {
          "key": "password",
          "path": "wifi.password",
          "type": "text",
          "label": "Пароль",
          "placeholder": "",
          "helpTitle": "Пароль",
          "help": "Пароль сети Wi‑Fi устройства."
        },
        {
          "key": "ap_timeout_enabled",
          "path": "wifi.ap_timeout_enabled",
          "type": "toggle",
          "label": "Автовыключение Wi‑Fi",
          "labelOn": "Вкл",
          "labelOff": "Выкл",
          "helpTitle": "Автовыключение Wi‑Fi",
          "help": "Выключает Wi‑Fi через заданное время после старта."
        },
        {
          "key": "ap_timeout_sec",
          "path": "wifi.ap_timeout_sec",
          "type": "number",
          "valueType": "int",
          "label": "Таймаут (с)",
          "step": "1",
          "min": "0",
          "showIf": {
            "eq": {
              "path": "wifi.ap_timeout_enabled",
              "value": true
            }
          },
          "helpTitle": "Таймаут (с)",
          "help": "Секунды до выключения Wi‑Fi. 0 — выключить сразу после старта."
        }
      ]
    },
    "gsm": {
      "title": "GSM",
      "fields": [
        {
          "key": "apn",
          "path": "gsm.apn",
          "type": "text",
          "label": "APN",
          "helpTitle": "APN",
          "help": "Точка доступа оператора для интернета по SIM."
        },
        {
          "key": "apn_user",
          "path": "gsm.apn_user",
          "type": "text",
          "label": "Логин",
          "helpTitle": "Логин",
          "help": "Логин APN. Пусто, если оператор его не задаёт."
        },
        {
          "key": "apn_pass",
          "path": "gsm.apn_pass",
          "type": "text",
          "label": "Пароль",
          "helpTitle": "Пароль",
          "help": "Пароль APN. Пусто, если оператор его не задаёт."
        },
        {
          "key": "owner_phone",
          "path": "gsm.owner_phone",
          "type": "text",
          "label": "Номер владельца",
          "placeholder": "+71234567890",
          "helpTitle": "Номер владельца",
          "help": "Номер владельца в формате +7… для звонков и SMS."
        },
        {
          "key": "dtmf_password",
          "path": "gsm.dtmf_password",
          "type": "text",
          "label": "Код звонка",
          "placeholder": "",
          "helpTitle": "Код звонка",
          "help": "Код, который вводят тонами во время звонка на устройство."
        }
      ]
    },
    "mqtt": {
      "title": "MQTT",
      "fields": [
        {
          "key": "broker",
          "path": "mqtt.broker",
          "type": "text",
          "label": "Брокер",
          "helpTitle": "Брокер",
          "help": "Адрес MQTT-брокера."
        },
        {
          "key": "port",
          "path": "mqtt.port",
          "type": "number",
          "valueType": "int",
          "label": "Порт",
          "min": "1",
          "max": "65535",
          "helpTitle": "Порт",
          "help": "Порт брокера: 1883 или 8883."
        },
        {
          "key": "client_id",
          "path": "mqtt.client_id",
          "type": "text",
          "label": "Имя клиента",
          "helpTitle": "Имя клиента",
          "help": "Имя клиента на брокере. Должно быть уникальным."
        },
        {
          "key": "user",
          "path": "mqtt.user",
          "type": "text",
          "label": "Логин",
          "helpTitle": "Логин",
          "help": "Логин MQTT. Пусто — без авторизации."
        },
        {
          "key": "pass",
          "path": "mqtt.pass",
          "type": "text",
          "label": "Пароль",
          "helpTitle": "Пароль",
          "help": "Пароль MQTT."
        },
        {
          "key": "topic_prefix",
          "path": "mqtt.topic_prefix",
          "type": "text",
          "label": "Префикс топиков",
          "helpTitle": "Префикс топиков",
          "help": "Начало имён топиков, без «/» в конце."
        },
        {
          "key": "publish_interval_sec",
          "path": "mqtt.publish_interval_sec",
          "type": "number",
          "valueType": "int",
          "label": "Интервал статуса (с)",
          "min": "1",
          "max": "3600",
          "helpTitle": "Интервал статуса (с)",
          "help": "Как часто публиковать статус, в секундах."
        }
      ]
    },
    "vehicle": {
      "title": "Автомобиль",
      "fields": [
        {
          "key": "adc_calibrate_voltage",
          "path": "vehicle.adc_calibrate_voltage",
          "type": "number",
          "label": "Измеренное напряжение (В)",
          "step": "0.01",
          "min": "0.01",
          "placeholderLive": "voltage",
          "helpTitle": "Измеренное напряжение",
          "help": "Введите напряжение с мультиметра при текущем подключении АКБ и сохраните — коэффициент пересчитается автоматически."
        },
        {
          "key": "adc_voltage_coeff",
          "path": "vehicle.adc_voltage_coeff",
          "type": "number",
          "hidden": true,
          "label": "Коэффициент АЦП",
          "step": "0.000001",
          "min": "0",
          "helpTitle": "Коэффициент АЦП",
          "help": "Служебное поле: сохраняется в конфиге, редактируется только через калибровку."
        },
        {
          "key": "starter_relay_id",
          "path": "vehicle.starter_relay_id",
          "type": "select",
          "valueType": "int",
          "label": "Реле стартера",
          "optionsFrom": "relays",
          "helpTitle": "Реле стартера",
          "help": "Реле, которое включает стартер. Им управляет только шаг «Запуск двигателя»; в шагах «Реле» его выбрать нельзя."
        },
        {
          "key": "start_method",
          "path": "vehicle.start_method",
          "type": "select",
          "valueType": "string",
          "label": "Алгоритм запуска",
          "options": [
            {
              "value": "timed",
              "label": "По времени"
            },
            {
              "value": "rpm",
              "label": "По оборотам"
            },
            {
              "value": "input",
              "label": "По дискретному входу"
            }
          ],
          "helpTitle": "Алгоритм запуска",
          "help": "По времени — стартер крутит заданное время, затем после паузы проверяется напряжение. По оборотам — стартер снимается сразу, как обороты на импульсном входе подтверждённо достигли порога входа. По дискретному входу — стартер снимается сразу, как вход стал активным. Вход для двух последних выбирается ниже."
        },
        {
          "key": "start_input_id",
          "path": "vehicle.start_input_id",
          "type": "select",
          "valueType": "int",
          "label": "Вход для запуска",
          "showIf": {
            "in": {
              "path": "vehicle.start_method",
              "values": ["rpm", "input"]
            }
          },
          "optionsFrom": "startInputIds",
          "helpTitle": "Вход для запуска",
          "help": "По оборотам — импульсный вход с заданным порогом (об/мин). По дискретному входу — дискретный вход. Вход должен быть включён."
        },
        {
          "key": "start_block_input_id",
          "path": "vehicle.start_block_input_id",
          "type": "select",
          "valueType": "int",
          "label": "Вход блокировки запуска",
          "optionsFrom": "digitalInputIds",
          "helpTitle": "Вход блокировки запуска",
          "help": "Капот, нейтраль, ручной тормоз. Пока вход активен, стартер не включается, а начатая прокрутка прекращается сразу. Если вход выключен или не найден, запуск запрещён."
        },
        {
          "key": "starter_crank_time_sec",
          "path": "vehicle.starter_crank_time_sec",
          "type": "number",
          "label": "Время прокрутки (с)",
          "step": "0.1",
          "min": "0.5",
          "max": "30",
          "showIf": {
            "eq": {
              "path": "vehicle.start_method",
              "value": "timed"
            }
          },
          "helpTitle": "Время прокрутки (с)",
          "help": "Сколько крутит стартер в одной попытке (рабочее время). Не больше максимального времени стартера."
        },
        {
          "key": "starter_max_time_sec",
          "path": "vehicle.starter_max_time_sec",
          "type": "number",
          "valueType": "int",
          "label": "Макс. время стартера (с)",
          "min": "1",
          "max": "30",
          "helpTitle": "Макс. время стартера (с)",
          "help": "Предохранитель: дольше реле стартера не включится никогда, кто бы его ни включил. Для запуска по оборотам и по входу — ещё и предел ожидания в одной попытке."
        },
        {
          "key": "wait_after_start_sec",
          "path": "vehicle.wait_after_start_sec",
          "type": "number",
          "valueType": "int",
          "label": "Пауза до проверки напряжения (с)",
          "min": "2",
          "max": "120",
          "showIf": {
            "eq": {
              "path": "vehicle.start_method",
              "value": "timed"
            }
          },
          "helpTitle": "Пауза до проверки напряжения (с)",
          "help": "Только для запуска по времени: сколько ждать после прокрутки, прежде чем сравнить напряжение с порогом «заведён». Просадка от прокрутки в проверку не попадает."
        },
        {
          "key": "engine_running_voltage_threshold",
          "path": "vehicle.engine_running_voltage_threshold",
          "type": "number",
          "label": "Порог «заведён» (В)",
          "step": "0.1",
          "min": "5",
          "max": "30",
          "helpTitle": "Порог «заведён» (В)",
          "help": "Напряжение, выше которого двигатель считается заведённым. Запуск по времени считается успешным при напряжении не ниже порога; если оно уже выше порога, стартер не крутит."
        },
        {
          "key": "starter_retry_pause_sec",
          "path": "vehicle.starter_retry_pause_sec",
          "type": "number",
          "valueType": "int",
          "label": "Пауза между прокрутками (с)",
          "min": "0",
          "max": "600",
          "helpTitle": "Пауза между прокрутками (с)",
          "help": "Отдых стартера и АКБ между неудачной попыткой и следующей."
        },
        {
          "key": "starter_attempts",
          "path": "vehicle.starter_attempts",
          "type": "number",
          "valueType": "int",
          "label": "Попыток запуска",
          "min": "1",
          "max": "5",
          "helpTitle": "Попыток запуска",
          "help": "Сколько раз крутить стартер в одном шаге «Запуск двигателя». После последней неудачи все реле выключаются."
        },
        {
          "key": "engine_stopped_voltage_threshold",
          "path": "vehicle.engine_stopped_voltage_threshold",
          "type": "number",
          "label": "Порог «заглушен» (В)",
          "step": "0.1",
          "min": "5",
          "max": "30",
          "helpTitle": "Порог «заглушен» (В)",
          "help": "Для индикатора работы двигателя: ниже этого напряжения двигатель заглушен. До порога «заведён» состояние не меняется."
        },
        {
          "key": "engine_detection_source",
          "path": "vehicle.engine_detection_source",
          "type": "select",
          "label": "Контроль двигателя",
          "options": [
            {
              "value": "voltage",
              "label": "Напряжение"
            },
            {
              "value": "input",
              "label": "Вход"
            }
          ],
          "helpTitle": "Контроль двигателя",
          "help": "Индикатор «двигатель работает» для статуса и шагов-условий: по напряжению или по входу. На алгоритм запуска не влияет."
        },
        {
          "key": "engine_input_id",
          "path": "vehicle.engine_input_id",
          "type": "select",
          "valueType": "int",
          "label": "Вход двигателя",
          "showIf": {
            "eq": {
              "path": "vehicle.engine_detection_source",
              "value": "input"
            }
          },
          "optionsFrom": "inputIds",
          "helpTitle": "Вход двигателя",
          "help": "Вход сигнала «двигатель работает»."
        }
      ]
    },
    "sensors": {
      "title": "Датчики",
      "repeatFrom": "MAX_SENSORS",
      "itemTitlePrefix": "Датчик",
      "fields": [
        {
          "key": "rom",
          "pathTmpl": "sensors.{i}.rom",
          "type": "select",
          "label": "ROM",
          "optionsFrom": "sensorRoms",
          "helpTitle": "ROM",
          "help": "Адрес датчика на шине 1-Wire."
        },
        {
          "key": "name",
          "pathTmpl": "sensors.{i}.name",
          "type": "text",
          "label": "Имя",
          "helpTitle": "Имя",
          "help": "Имя датчика в интерфейсе."
        },
        {
          "key": "coeff",
          "pathTmpl": "sensors.{i}.coeff",
          "type": "number",
          "label": "Смещение (°C)",
          "step": "0.1",
          "helpTitle": "Смещение (°C)",
          "help": "Поправка к показанию температуры, °C."
        }
      ]
    },
    "inputs": {
      "title": "Входы",
      "repeatFrom": "MAX_INPUTS",
      "itemTitleFrom": "inputs",
      "fields": [
        {
          "bind": "enabled",
          "pathTmpl": "inputs.{i}.enabled",
          "type": "toggle",
          "label": "Активен",
          "labelOn": "Вкл",
          "labelOff": "Выкл",
          "helpTitle": "Активен",
          "help": "Вход обрабатывается после старта."
        },
        {
          "bind": "id",
          "pathTmpl": "inputs.{i}.id",
          "type": "number",
          "label": "ID",
          "hidden": true,
          "helpTitle": "ID",
          "help": "Идентификатор входа."
        },
        {
          "bind": "name",
          "pathTmpl": "inputs.{i}.name",
          "type": "text",
          "label": "Имя",
          "helpTitle": "Имя",
          "help": "Имя входа в интерфейсе."
        },
        {
          "bind": "type",
          "pathTmpl": "inputs.{i}.type",
          "type": "select",
          "label": "Тип",
          "options": [
            {
              "value": 0,
              "label": "Дискретный"
            },
            {
              "value": 1,
              "label": "Импульсный"
            }
          ],
          "helpTitle": "Тип",
          "help": "Дискретный — вкл/выкл. Импульсный — обороты."
        },
        {
          "bind": "active_state",
          "pathTmpl": "inputs.{i}.active_state",
          "type": "select",
          "label": "Активный уровень",
          "showIf": {
            "eq": {
              "pathTmpl": "inputs.{i}.type",
              "value": 0
            }
          },
          "options": [
            {
              "value": true,
              "label": "Высокий"
            },
            {
              "value": false,
              "label": "Низкий"
            }
          ],
          "helpTitle": "Активный уровень",
          "help": "Какой уровень считать активным: высокий или низкий."
        },
        {
          "bind": "pulse.pulses_per_rev",
          "pathTmpl": "inputs.{i}.pulse.pulses_per_rev",
          "type": "number",
          "valueType": "int",
          "min": "1",
          "step": "1",
          "label": "Имп./оборот",
          "showIf": {
            "eq": {
              "pathTmpl": "inputs.{i}.type",
              "value": 1
            }
          },
          "helpTitle": "Имп./оборот",
          "help": "Сколько перепадов уровня (оба фронта) датчик даёт за один оборот: один импульс на оборот — 2."
        },
        {
          "bind": "pulse.threshold_rpm",
          "pathTmpl": "inputs.{i}.pulse.threshold_rpm",
          "type": "number",
          "valueType": "int",
          "min": "0",
          "step": "1",
          "label": "Порог (об/мин)",
          "showIf": {
            "eq": {
              "pathTmpl": "inputs.{i}.type",
              "value": 1
            }
          },
          "helpTitle": "Порог (об/мин)",
          "help": "Обороты, которые держатся на пороге 100 мс, делают вход активным; ими же снимается стартер при запуске по оборотам. 0 — вход никогда не активен."
        }
      ]
    },
    "triggers": {
      "title": "Триггеры",
      "inputFields": [
        {
          "bind": "id",
          "type": "number",
          "label": "ID",
          "hidden": true,
          "helpTitle": "ID",
          "help": "Идентификатор триггера."
        },
        {
          "bind": "enabled",
          "type": "toggle",
          "label": "Активен",
          "labelOn": "Вкл",
          "labelOff": "Выкл",
          "helpTitle": "Активен",
          "help": "Триггер работает после старта."
        },
        {
          "bind": "input_id",
          "type": "select",
          "valueType": "int",
          "label": "Вход",
          "optionsFrom": "inputIds",
          "helpTitle": "Вход",
          "help": "Вход, по которому запускается программа."
        },
        {
          "bind": "trigger_level",
          "type": "select",
          "label": "Уровень",
          "options": [
            {
              "value": 0,
              "label": "Низкий"
            },
            {
              "value": 1,
              "label": "Высокий"
            }
          ],
          "helpTitle": "Уровень",
          "help": "Уровень входа для запуска."
        },
        {
          "bind": "program_id",
          "type": "select",
          "label": "Программа",
          "optionsFrom": "programs",
          "helpTitle": "Программа",
          "help": "Программа, которая запускается."
        }
      ],
      "tempFields": [
        {
          "bind": "id",
          "type": "number",
          "label": "ID",
          "hidden": true,
          "helpTitle": "ID",
          "help": "Идентификатор триггера."
        },
        {
          "bind": "enabled",
          "type": "toggle",
          "label": "Активен",
          "labelOn": "Вкл",
          "labelOff": "Выкл",
          "helpTitle": "Активен",
          "help": "Триггер работает после старта."
        },
        {
          "bind": "sensor_id",
          "type": "select",
          "label": "Датчик",
          "optionsFrom": "sensorIds",
          "helpTitle": "Датчик",
          "help": "Датчик для проверки температуры."
        },
        {
          "bind": "sensor_name",
          "type": "text",
          "label": "Имя датчика",
          "hidden": true,
          "helpTitle": "Имя датчика",
          "help": "Имя выбранного датчика."
        },
        {
          "bind": "comparison",
          "type": "select",
          "label": "Условие",
          "options": [
            {
              "value": "above",
              "label": "Выше"
            },
            {
              "value": "below",
              "label": "Ниже"
            }
          ],
          "helpTitle": "Условие",
          "help": "Запуск, если температура выше или ниже порога."
        },
        {
          "bind": "threshold",
          "type": "number",
          "label": "Порог (°C)",
          "step": "0.1",
          "helpTitle": "Порог (°C)",
          "help": "Температура запуска, °C."
        },
        {
          "bind": "program_id",
          "type": "select",
          "label": "Программа",
          "optionsFrom": "programs",
          "helpTitle": "Программа",
          "help": "Программа, которая запускается."
        }
      ],
      "scheduleFields": [
        {
          "bind": "id",
          "type": "number",
          "label": "ID",
          "hidden": true,
          "helpTitle": "ID",
          "help": "Идентификатор расписания."
        },
        {
          "bind": "enabled",
          "type": "toggle",
          "label": "Активен",
          "labelOn": "Вкл",
          "labelOff": "Выкл",
          "helpTitle": "Активен",
          "help": "Запуск по часам устройства. Нужна синхронизация времени."
        },
        {
          "bind": "hour",
          "type": "number",
          "valueType": "int",
          "label": "Час",
          "min": "0",
          "max": "23",
          "step": "1",
          "helpTitle": "Час",
          "help": "Час запуска, 0–23."
        },
        {
          "bind": "minute",
          "type": "number",
          "valueType": "int",
          "label": "Минута",
          "min": "0",
          "max": "59",
          "step": "1",
          "helpTitle": "Минута",
