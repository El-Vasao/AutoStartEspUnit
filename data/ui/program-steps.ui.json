{
  "programSteps": {
    "params": {
      "relay_id": {
        "label": "Реле",
        "type": "select",
        "optionsFrom": "relays",
        "valueType": "int",
        "helpTitle": "Реле",
        "help": "Реле, которым управляет шаг.",
        "default": 2001
      },
      "ms": {
        "label": "Длительность (с)",
        "type": "number",
        "valueType": "float",
        "step": 0.1,
        "min": 0,
        "helpTitle": "Длительность (с)",
        "help": "Секунды. Пауза — ожидание, импульс — длина фазы, звонок — время до отбоя.",
        "default": 1
      },
      "input_id": {
        "label": "Вход",
        "type": "select",
        "optionsFrom": "inputs",
        "valueType": "int",
        "helpTitle": "Вход",
        "help": "Вход для этого шага.",
        "default": 1001
      },
      "input_trigger_id": {
        "label": "Триггер входа",
        "type": "select",
        "optionsFrom": "inputTriggerIds",
        "valueType": "int",
        "helpTitle": "Триггер входа",
        "help": "Какой входной триггер включить или выключить.",
        "default": 0
      },
      "temp_trigger_id": {
        "label": "Триггер температуры",
        "type": "select",
        "optionsFrom": "tempTriggerIds",
        "valueType": "int",
        "helpTitle": "Триггер температуры",
        "help": "Какой температурный триггер включить или выключить.",
        "default": 0
      },
      "retries": {
        "label": "Попытки",
        "type": "number",
        "valueType": "int",
        "step": 1,
        "min": 1,
        "helpTitle": "Попытки",
        "help": "Сколько раз повторить шаг. 1 — без повторов.",
        "default": 1
      },
      "sensor_id": {
        "label": "Датчик",
        "type": "select",
        "optionsFrom": "sensorIds",
        "valueType": "int",
        "helpTitle": "Датчик",
        "help": "Датчик для условия.",
        "default": 0
      },
      "sensor_name": {
        "label": "Имя датчика",
        "type": "text",
        "valueType": "string",
        "default": "",
        "hidden": true
      },
      "program_id": {
        "label": "Программа",
        "type": "select",
        "optionsFrom": "programs",
        "valueType": "int",
        "helpTitle": "Программа",
        "help": "Какую программу запустить.",
        "default": 0
      },
      "timeout_ms": {
        "label": "Таймаут (с)",
        "type": "number",
        "valueType": "float",
        "step": 0.1,
        "min": 0,
        "helpTitle": "Таймаут (с)",
        "help": "Сколько ждать завершения шага. 0 — без ограничения.",
        "default": 0
      },
      "expected_state": {
        "label": "Состояние",
        "type": "select",
        "valueType": "int",
        "options": [
          {
            "value": 0,
            "label": "Выкл"
          },
          {
            "value": 1,
            "label": "Вкл"
          }
        ],
        "helpTitle": "Состояние",
        "help": "Какое состояние считать выполненным: вкл или выкл.",
        "default": 1
      },
      "comparison": {
        "label": "Сравнение",
        "type": "select",
        "valueType": "string",
        "options": [
          {
            "value": "above",
            "label": "Выше"
          },
          {
            "value": "below",
            "label": "Ниже"
          }
        ],
        "helpTitle": "Сравнение",
        "help": "Сравнивать значение выше или ниже порога.",
        "default": "above"
      },
      "threshold": {
        "label": "Порог",
        "type": "number",
        "valueType": "float",
        "step": 0.1,
        "helpTitle": "Порог",
        "help": "Значение для сравнения.",
        "default": 0
      },
      "engine_state": {
        "label": "Двигатель",
        "type": "select",
        "valueType": "int",
        "options": [
          {
            "value": 0,
            "label": "Выкл"
          },
          {
            "value": 1,
            "label": "Вкл"
          }
        ],
        "helpTitle": "Двигатель",
        "help": "Нужное состояние двигателя: вкл или выкл.",
        "default": 1
      },
      "timeout_action": {
        "label": "При таймауте",
        "type": "select",
        "valueType": "int",
        "options": [
          {
            "value": 0,
            "label": "Остановить"
          },
          {
            "value": 1,
            "label": "Пропустить шаги"
          }
        ],
        "helpTitle": "При таймауте",
        "help": "По таймауту остановить программу или пропустить следующие шаги.",
        "default": 0
      },
      "skip_count": {
        "label": "Пропустить",
        "type": "number",
        "valueType": "int",
        "min": 1,
        "step": 1,
        "helpTitle": "Пропустить",
        "help": "Сколько следующих шагов пропустить при таймауте.",
        "default": 1
      },
      "message": {
        "label": "Текст SMS",
        "type": "text",
        "valueType": "string",
        "maxLength": 64,
        "helpTitle": "Текст SMS",
        "help": "Текст SMS владельцу, до 64 символов.",
        "default": ""
      }
    },
    "actionCategories": [
